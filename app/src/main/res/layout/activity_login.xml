<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Spacer atas -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp"/>

        <!-- Logo Buku -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/logo_buku"
            android:scaleType="fitCenter"
            android:contentDescription="Logo ZenStudy"/>

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Selamat Datang Kembali!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lanjutkan perjalanan belajarmu dengan fokus penuh."
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:gravity="center"/>

        <!-- Input Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_email"
                android:contentDescription="Email icon"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="Email"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent"
                android:inputType="textEmailAddress"
                android:singleLine="true"/>

        </LinearLayout>

        <!-- Input Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_lock_idle_lock"
                android:contentDescription="Password icon"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="Password"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent"
                android:inputType="textPassword"
                android:singleLine="true"/>

        </LinearLayout>

        <!-- Lupa kata sandi -->
        <TextView
            android:id="@+id/tvLupaPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lupa kata sandi?"
            android:textSize="13sp"
            android:textColor="#1A1A1A"
            android:gravity="end"
            android:textStyle="bold"/>

        <!-- Tombol Masuk -->
        <TextView
            android:id="@+id/btnMasuk"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="MASUK →"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:letterSpacing="0.05"/>

        <!-- Atau -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="atau"
            android:textSize="13sp"
            android:textColor="#9E9E9E"/>

        <!-- Tombol Google -->
        <LinearLayout
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_google"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="G"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4285F4"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Masuk dengan Google"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

        </LinearLayout>

        <!-- Spacer -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Daftar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum punya akun? "
                android:textSize="13sp"
                android:textColor="#6B6B6B"/>

            <TextView
                android:id="@+id/tvDaftar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar di sini"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>