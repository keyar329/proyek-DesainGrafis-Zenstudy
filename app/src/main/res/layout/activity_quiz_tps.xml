<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_back_button"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Latihan Soal"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSoalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Soal 1 / 10"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/quizProgressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:max="10"
        android:progress="1"
        android:progressDrawable="@drawable/bg_progress_subject"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Timer Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_time" app:tint="#1A1A1A"/>
                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="00:00"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Question Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvSoalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="SOAL 1"
                        android:textColor="#1A1A1A"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/bg_badge_outline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="PENALARAN ANALITIS"
                        android:textColor="#6B6B6B"
                        android:textSize="10sp"/>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#EEEEEE"/>

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Jika semua dokter adalah sarjana, and Andi adalah seorang dokter, maka pernyataan yang PASTI BENAR adalah..."
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pilih satu jawaban yang paling tepat."
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:fontStyle="italic"/>

            </LinearLayout>

            <!-- Options Container -->
            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Option A -->
                <LinearLayout
                    android:id="@+id/optionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option_default"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_badge_outline" android:text="A" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:id="@+id/tvOptionA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Andi pasti seorang sarjana" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Option B -->
                <LinearLayout
                    android:id="@+id/optionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option_default"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_badge_outline" android:text="B" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:id="@+id/tvOptionB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Andi mungkin bukan sarjana" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Option C -->
                <LinearLayout
                    android:id="@+id/optionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option_default"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_badge_outline" android:text="C" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:id="@+id/tvOptionC" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Semua sarjana adalah dokter" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Option D -->
                <LinearLayout
                    android:id="@+id/optionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_option_default"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_badge_outline" android:text="D" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:id="@+id/tvOptionD" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Andi bukan seorang dokter" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Tip Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_light_green_card"
                android:padding="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tenang, tidak ada penalti salah."
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Baca soal dengan teliti sebelum menjawab."
                    android:textColor="#6B6B6B"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Action Buttons -->
            <TextView
                android:id="@+id/btnKonfirmasi"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:text="KONFIRMASI JAWABAN"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/btnSkip"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center"
                android:text="Lewati Soal Ini"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>