<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Gambar dari Figma -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/card_illustration"
        android:scaleType="fitCenter"
        android:contentDescription="Illustration"/>

    <!-- Judul -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Persiapkan Dirimu,\nTenangkan Pikiranmu."
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:lineSpacingExtra="6dp"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Solusi belajar UTBK efektif tanpa burnout dengan dukungan mindfulness."
        android:textSize="14sp"
        android:textColor="#6B6B6B"
        android:gravity="center"
        android:lineSpacingExtra="6dp"/>

    <!-- Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Tombol Mulai -->
    <TextView
        android:id="@+id/btnMulai"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_button_primary"
        android:text="MULAI SEKARANG"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:letterSpacing="0.05"/>

    <!-- Tombol Login -->
    <TextView
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_secondary"
        android:text="SAYA SUDAH PUNYA AKUN"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:letterSpacing="0.05"/>

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Dengan melanjutkan, kamu menyetujui Ketentuan &amp; Kebijakan kami."
        android:textSize="11sp"
        android:textColor="#9E9E9E"
        android:gravity="center"/>

</LinearLayout>