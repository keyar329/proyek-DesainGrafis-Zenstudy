<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_back_button"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Bab 1 / 10"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:layout_width="100dp"
        android:layout_height="4dp"
        android:layout_marginStart="16dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:progress="30"
        android:progressDrawable="@drawable/bg_progress_subject"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TPS: PENALARAN UMUM > BAB 1"
                android:textColor="#6B6B6B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Penalaran Analitis"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_time" app:tint="#6B6B6B"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="18 menit membaca"
                    android:textColor="#6B6B6B"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Card Materi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apa itu Penalaran Analitis?"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Penalaran analitis adalah kemampuan untuk memahami struktur dari suatu hubungan logis dan menarik kesimpulan dari hubungan tersebut. Dalam ujian TPS, tipe soal ini menguji bagaimana kamu dapat mengorganisir informasi yang acak menjadi sebuah kesimpulan yang pasti."
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_light_green_card"
                    android:padding="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kunci Utama: Jangan berasumsi di luar informasi yang diberikan. Jika tidak tertulis, maka belum tentu benar."
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Card Contoh Soal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contoh Soal"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/bg_badge_green"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="TIPE A"
                        android:textColor="#1A1A1A"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#EEEEEE"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Lima orang siswa A, B, C, D, dan E duduk berderet. A tidak bersebelahan dengan B. C duduk di ujung kanan. D duduk tepat di sebelah kiri C. Siapakah yang mungkin duduk di tengah?"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>

                <!-- Options -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_back_button"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_outline" android:text="A" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Siswa A" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_back_button"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_outline" android:text="B" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Siswa B" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_back_button"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_badge_outline" android:text="C" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Siswa E" android:textColor="#1A1A1A" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_badge_outline"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_search_small" app:tint="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="LIHAT PEMBAHASAN" android:textColor="#1A1A1A" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Break Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_mood_card"
                android:backgroundTint="#D1F5D9"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_meditation" app:tint="#1A1A1A"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sudah 10 menit membaca!"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Istirahatkan mata dan pikiranmu sejenak\nagar materi lebih mudah diserap."
                    android:textColor="#6B6B6B"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_white_card"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="10dp"
                    android:text="Sesi Napas 1 Menit"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Bottom Buttons -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:text="LANJUT BAB 2  →"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/btnLatihanSoal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center"
                android:text="KERJAKAN LATIHAN SOAL"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="40dp"
                android:letterSpacing="0.05"/>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#1A1A1A"
        app:itemTextColor="#1A1A1A"
        app:elevation="8dp"/>

</LinearLayout>