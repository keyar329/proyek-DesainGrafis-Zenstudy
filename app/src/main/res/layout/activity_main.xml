<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo, Kevin!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fokus hari ini, tenang esok hari."
                android:textSize="13sp"
                android:textColor="#6B6B6B"
                android:layout_marginTop="4dp"/>

            <!-- Mood Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_mood_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gimana energimu hari ini?"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pilih yang paling menggambarkan kondisimu"
                    android:textSize="12sp"
                    android:textColor="#1A1A1A"/>

                <!-- Baris 1: Semangat + Biasa Aja -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mood_button"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="#FFD700"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semangat"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"/>
                    </LinearLayout>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mood_button"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="#86D9A0"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Biasa Aja"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Baris 2: Ngantuk + Burnout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mood_button"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="#64B5F6"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngantuk"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"/>
                    </LinearLayout>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mood_button"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="#FF8A65"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Burnout"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Pilih Mode Belajar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pilih Mode Belajar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rekomendasi berdasarkan energimu"
                android:textSize="12sp"
                android:textColor="#6B6B6B"/>

            <!-- Deep Work Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_deep_work_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_dark"
                    android:text="  DEEP WORK  "
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Materi berat &amp; latihan soal intensif"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Untuk saat energimu penuh"
                            android:textSize="12sp"
                            android:textColor="#1A1A1A"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Quick Review + Chill Study -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Quick Review -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_dark"
                        android:text="  QUICK REVIEW  "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mengulang konsep kunci"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sesi singkat"
                        android:textSize="11sp"
                        android:textColor="#6B6B6B"/>

                </LinearLayout>

                <Space android:layout_width="10dp" android:layout_height="wrap_content"/>

                <!-- Chill Study -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_dark"
                        android:text="  CHILL STUDY  "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Membaca santai"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Saat energi rendah"
                        android:textSize="11sp"
                        android:textColor="#6B6B6B"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Sesi Fokus -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sesi Fokus"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="25 menit"
                            android:textSize="12sp"
                            android:textColor="#6B6B6B"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25:00"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="#86D9A0"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/btnMulaiFokus"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="MULAI FOKUS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:gravity="center"
                    android:letterSpacing="0.05"/>

            </LinearLayout>

            <!-- Konsistensi Belajar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Konsistensi Belajar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="7 hari terakhir"
                android:textSize="12sp"
                android:textColor="#6B6B6B"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Sen -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sen" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle"/>
                </LinearLayout>

                <!-- Sel -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sel" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle_done" android:text="✓" android:gravity="center" android:textSize="14sp" android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Rab -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rab" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle_done" android:text="✓" android:gravity="center" android:textSize="14sp" android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Kam -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kam" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle"/>
                </LinearLayout>

                <!-- Jum -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jum" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle"/>
                </LinearLayout>

                <!-- Sab -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sab" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle"/>
                </LinearLayout>

                <!-- Min -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min" android:textSize="11sp" android:textColor="#6B6B6B"/>
                    <View android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="4dp" android:background="@drawable/bg_day_circle"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#1A1A1A"
        app:itemTextColor="#1A1A1A"
        app:elevation="8dp"/>

</LinearLayout>