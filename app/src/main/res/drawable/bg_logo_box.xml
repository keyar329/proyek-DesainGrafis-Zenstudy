<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow hitam (offset ke kanan-bawah, brutalist style) -->
    <item
        android:left="7dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Kotak hijau utama dengan border hitam -->
    <item
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#86D9A0"/>
            <stroke
                android:width="2dp"
                android:color="#1A1A1A"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

</layer-list>